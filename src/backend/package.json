{
  "name": "backend",
  "description": "headless cms powered by Strapi",
  "devEngines": {
    "runtime": { "name": "node", "version": "24.x.x" },
    "packageManager": { "name": "pnpm", "version": "12.4.1" }
  },
  "scripts": {
    "build": "strapi build",
    "console": "strapi console",
    "dev": "strapi develop",
    "start": "strapi start",
    "strapi": "strapi",
    "upgrade": "pnx @strapi/upgrade latest",
    "upgrade:dry": "pnx @strapi/upgrade latest --dry",
    "token": "pnx ts-node ./scripts/tokens.ts"
  },
  "dependencies": {
    "@strapi/plugin-users-permissions": "5.55.1",
    "@strapi/strapi": "5.55.1",
    "better-sqlite3": "11.3.0",
    "fs-extra": "^10.0.0",
    "mime-types": "^2.1.27",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "typescript": "^5"
  }
}
